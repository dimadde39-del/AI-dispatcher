# Supabase project URL, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Vapi public key, safe to expose to the browser for dev Web Call testing.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# Self-host voice-agent URL, safe to expose for local dev STT testing.
NEXT_PUBLIC_SELF_HOST_VOICE_AGENT_URL=http://localhost:8001

# Supabase service role key. Server-side only. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: direct database connection for Supabase CLI / migrations / scripts.
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# Telegram, used later.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Vapi webhook foundation. VAPI_API_KEY is only needed for optional Vapi API scripts.
# Vapi webhook verification uses the x-vapi-webhook-secret header when VAPI_WEBHOOK_SECRET is set.
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=cc79d655-ed1f-47fb-ab03-a55558e8f48a

# Self-host voice spike webhook verification.
# Uses the x-self-host-voice-secret header when configured.
SELF_HOST_VOICE_WEBHOOK_SECRET=

# LLM providers, used later.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# App config.
APP_BASE_URL=http://localhost:3000
ENABLE_DEV_VAPI_WEB_CALL=false
ENABLE_DEV_SELFHOST_STT=false
NODE_ENV=development
