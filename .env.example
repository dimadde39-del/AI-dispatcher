# Supabase project URL, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key. Server-side only. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: direct database connection for Supabase CLI / migrations / scripts.
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# Telegram, used later.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Vapi, used later.
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# LLM providers, used later.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# App config.
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
